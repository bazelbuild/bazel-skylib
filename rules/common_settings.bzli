"""Values and implementations for the common build settings."""

def BuildSettingInfo[T = object](*, value: T) -> record[{"value": T}]: ...

type _VariableAttrs = struct[{"make_variable": str}, ...]
type _StringAttrs = struct[{"make_variable": str, "values": list[str]}, ...]

class _SettingContext[T, A](Protocol):
    @property
    def attr(self) -> A: ...
    @property
    def label(self) -> Label: ...
    @property
    def build_setting_value(self) -> T: ...

def _get_template_variable_info(ctx: _SettingContext[object, _VariableAttrs]) -> list[TemplateVariableInfo]: ...
def _impl[T](ctx: _SettingContext[T, _VariableAttrs]) -> list[BuildSettingInfo[T] | TemplateVariableInfo]: ...
def _simple_impl[T](ctx: _SettingContext[T, object]) -> BuildSettingInfo[T]: ...
def _string_impl(ctx: _SettingContext[str, _StringAttrs]) -> list[BuildSettingInfo[str] | TemplateVariableInfo]: ...
