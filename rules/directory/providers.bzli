"""Directory helper contracts and their complete provider results."""

class DirectoryContent(Protocol):
    @property
    def entries(self) -> dict[str, File | DirectoryInfo]: ...
    @property
    def human_readable(self) -> str: ...

class _Glob(Protocol):
    def __call__(self, include: Sequence[str], exclude: Sequence[str] = ..., allow_empty: bool = ...) -> depset[File]: ...

# TODO(https://github.com/bazelbuild/bazel/issues/31770): annotate the provider initializer
# in Starlark once Bazel accepts dictionaries with named, typed keys.
type _Input = dict[{
    "entries": dict[str, File | DirectoryInfo],
    "transitive_files": depset[File],
    "path": str,
    "human_readable": str,
    "get_path": NotRequired[object],
    "get_file": NotRequired[object],
    "get_subdirectory": NotRequired[object],
    "glob": NotRequired[object],
}]

type _Fields = dict[{
    "entries": dict[str, File | DirectoryInfo],
    "transitive_files": depset[File],
    "path": str,
    "human_readable": str,
    "get_path": Callable[[str], File | DirectoryInfo],
    "get_file": Callable[[str], File],
    "get_subdirectory": Callable[[str], DirectoryInfo],
    "glob": _Glob,
}]

def _init_directory_info(**kwargs: Unpack[_Input]) -> _Fields: ...
def create_directory_info(**kwargs: Unpack[_Input]) -> DirectoryInfo: ...

def DirectoryInfo(**kwargs: Unpack[_Fields]) -> record[{
    "entries": dict[str, File | DirectoryInfo],
    "transitive_files": depset[File],
    "path": str,
    "human_readable": str,
    "get_path": Callable[[str], File | DirectoryInfo],
    "get_file": Callable[[str], File],
    "get_subdirectory": Callable[[str], DirectoryInfo],
    "glob": _Glob,
}]: ...
