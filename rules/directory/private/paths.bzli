"""Path lookup over directory entries."""

load("//rules/directory:providers.bzli", "DirectoryInfo", _DirectoryContent = "DirectoryContent")

def _get_direct_child(directory: _DirectoryContent, name: str) -> File | DirectoryInfo: ...
def _get_direct_subdirectory(directory: _DirectoryContent, name: str) -> DirectoryInfo: ...
def _get_parent(directory: _DirectoryContent, path: str) -> tuple[_DirectoryContent, str]: ...
def get_path(directory: _DirectoryContent, path: str, require_type: str | None = ...) -> File | DirectoryInfo: ...
def get_file(directory: _DirectoryContent, path: str) -> File: ...
def get_subdirectory(directory: _DirectoryContent, path: str) -> DirectoryInfo: ...
