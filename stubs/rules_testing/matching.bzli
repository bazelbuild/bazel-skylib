# TODO(https://github.com/bazelbuild/bazel/issues/32370): Drop this stub when
# rules_testing can declare the membership operation matching.contains() needs.
class _Contains[T](Protocol):
    @type_check_only
    def __contains__(self, item: T, /) -> bool: ...

type Matcher[T] = struct[{"desc": str, "match": Callable[[T], bool]}, ...]

def _match_contains[T](contained: T) -> Matcher[_Contains[T]]: ...
