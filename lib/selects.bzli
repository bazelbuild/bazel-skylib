"""Contracts for configurable attribute helpers."""

# TODO(https://github.com/bazelbuild/starlark/pull/362): Move these contracts into
# selects.bzl when every supported Bazel release accepts generic function syntax and
# source annotations can describe _ConditionEntries.items() and typed selector results.
type _Condition = str | Label
type _Conditions = Sequence[_Condition]
type _Visibility = Collection[_Condition] | depset[_Condition] | None

class _ConditionEntries[V](Protocol):
    def items(self) -> Collection[tuple[_Condition | tuple[_Condition, ...], V]]: ...

def _with_or[V](input_dict: _ConditionEntries[V], no_match_error: str = ...) -> select[V, object]: ...
def _with_or_dict[V](input_dict: _ConditionEntries[V]) -> dict[_Condition, V]: ...
def _config_setting_group(name: str, match_any: _Conditions = ..., match_all: _Conditions = ..., visibility: _Visibility = ...) -> None: ...
def _check_duplicates(settings: _Conditions) -> None: ...
def _remove_default_condition(settings: _Conditions) -> list[_Condition]: ...
def _config_setting_or_group(name: str, settings: _Conditions, visibility: _Visibility) -> None: ...
def _config_setting_and_group(name: str, settings: _Conditions, visibility: _Visibility) -> None: ...
def _config_setting_always_true(name: str, visibility: _Visibility) -> None: ...
