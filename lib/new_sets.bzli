"""Contracts for hash-set helpers."""

type _Set[T: Hashable] = struct[{"_values": dict[T, None]}, ...]

# Union reads each input without changing its element type.
type _SetView[T: Hashable] = struct[{"_values": Intersection[Top[dict[Unknown, None]], Collection[T]]}, ...]

def _make[T: Hashable = Hashable](elements: Collection[T] | None = ...) -> _Set[T]: ...
def _copy[T: Hashable](s: _Set[T]) -> _Set[T]: ...
def _to_list[T: Hashable](s: _Set[T]) -> list[T]: ...
def _insert[T: Hashable](s: _Set[T], e: T) -> _Set[T]: ...
def _remove[T: Hashable](s: _Set[T], e: T) -> _Set[T]: ...
def _contains[T: Hashable](a: _Set[T], e: Hashable) -> bool: ...
def _get_shorter_and_longer[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> tuple[_Set[A], _Set[B]] | tuple[_Set[B], _Set[A]]: ...
def _is_equal[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> bool: ...
def _is_subset[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> bool: ...
def _disjoint[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> bool: ...
def _intersection[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> _Set[A | B]: ...
def _union[T: Hashable = Hashable](*args: _SetView[T]) -> _Set[T]: ...
def _difference[A: Hashable, B: Hashable](a: _Set[A], b: _Set[B]) -> _Set[A]: ...
def _length[T: Hashable](s: _Set[T]) -> int: ...
def _repr[T: Hashable](s: _Set[T]) -> str: ...
